{
  "name": "brood",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "brood": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "brood.example.json",
    "plan.md",
    "docs",
    "vendor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run format:check && pnpm run lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "test:live": "vitest run test/live",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "effect": "4.0.0-beta.105",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.105",
    "@types/node": "24.12.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.28.1"
}
